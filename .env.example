# Server-side Baidu Maps Web Service AK. Keep the real value only in a local .env.
BAIDU_MAP_AK=
# Optional comma-separated browser origins; defaults to localhost:5173 and 127.0.0.1:5173.
CORS_ORIGINS=
# Server-side DeepSeek key for the Agent roles. Keep the real value only in a local .env.
# Optional overrides: DEEPSEEK_MODEL (default deepseek-flash) and DEEPSEEK_BASE_URL.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
# Set to 1 only when you intend to spend real model requests in smoke checks.
RUN_DEEPSEEK_SMOKE=
# Shared Baidu route quota for one AK. Defaults follow the free tier (3/s);
# raise them only after confirming the console quota for the account.
BAIDU_ROUTES_PER_SECOND=
BAIDU_QUOTA_MAX_WAIT_SECONDS=
# Baidu Web Service is forced to IPv4 because the console whitelist records
# IPv4 addresses while a dual-stack host would otherwise use IPv6 and be
# refused with status 210. Set to 0 only if the whitelist is IPv6.
BAIDU_FORCE_IPV4=
